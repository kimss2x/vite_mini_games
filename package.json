{
  "name": "noah-studio-mini-games",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src functions tests *.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && npx wrangler pages dev dist",
    "d1:migrate:local": "npx wrangler d1 migrations apply noah_studio_mini_games --local",
    "d1:migrate:remote": "npx wrangler d1 migrations apply noah_studio_mini_games --remote"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
